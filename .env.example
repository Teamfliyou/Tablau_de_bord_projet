# ==========================================================
#  TABLEAU DE BORD ÉTUDIANT - Variables d'environnement
#  Copie ce fichier vers `.env` puis complète les valeurs :
#      cp .env.example .env
#  NE JAMAIS committer le fichier `.env` (déjà dans .gitignore).
# ==========================================================

# URL du flux iCal (ICS) de ton emploi du temps ADE Campus.
# Se trouve dans l'application ADE : ton emploi du temps ->
# "Export" / "Agenda" -> copie le lien (contient généralement `data=` et `ics`).
ADE_ICS_URL=https://votre-ecole.example.com/ade/ics?data=remplace-par-ton-lien

# Clé API Google Gemini (gratuite via https://aistudio.google.com/apikey)
GEMINI_API_KEY=votre_cle_ici

# Port d'écoute du serveur FastAPI
PORT=8000

# Fuseau horaire utilisé pour interpréter les événements de l'emploi du temps
APP_TIMEZONE=Europe/Paris

# Modèle Gemini utilisé pour générer les plans de révision (facultatif)
GEMINI_MODEL=gemini-1.5-flash

# Plage horaire de travail suggérée à l'IA le soir (format HH:MM)
HEURE_DEBUT_ETUDES=19:00
HEURE_FIN_ETUDES=22:00

# Base de données SQLite (facultatif, valeur par défaut conservée)
DATABASE_URL=sqlite:///./tableau_bord.db
