# ==========================================================
#  TABLEAU DE BORD ÉTUDIANT - Variables d'environnement du serveur Web
#  Copie ce fichier vers `.env` puis complète les valeurs.
#  NE JAMAIS committer le fichier `.env` (déjà dans .gitignore).
# ==========================================================

# Secret de signature des sessions (JWT) et de chiffrement des clés Gemini : 16 caractères minimum.
# Génération : openssl rand -base64 48
# S'il est absent, un secret aléatoire est créé une fois à côté de la base (data/secret.key).
SECRET_KEY=

# Port d'écoute (ou BIND_ADDR=127.0.0.1:8000 pour une adresse précise)
PORT=8000

# Chemin de la base SQLite. L'ancienne URL « sqlite:///chemin/app.db » est aussi acceptée :
# une base de l'ancienne version Python est migrée automatiquement (avec sauvegarde préalable).
DATABASE_PATH=data/tableau-de-bord.db

# Dossier du frontend compilé (Trunk). Détecté automatiquement : frontend-dist/ ou crates/frontend/dist/
# FRONTEND_DIR=crates/frontend/dist

# Origines CORS acceptées, séparées par des virgules. Vide = même origine uniquement (recommandé).
ALLOWED_ORIGINS=

# Optionnel : restreint les liens ADE à une liste de domaines. Vide = tout domaine HTTPS public
# (les adresses privées, locales et de métadonnées cloud restent toujours bloquées).
ADE_ALLOWED_HOSTS=

# Clé Gemini globale facultative, utilisée si l'utilisateur n'a pas enregistré la sienne.
GEMINI_API_KEY=

# Durée de validité des sessions (minutes) et coût bcrypt
JWT_EXPIRATION_MINUTES=1440
BCRYPT_COST=12

# Cache des flux ICS : durée de vie (secondes) et nombre maximal d'entrées
ICS_CACHE_TTL_SECONDS=300
ICS_CACHE_MAX_ENTRIES=64

# Niveau de journalisation
RUST_LOG=info
